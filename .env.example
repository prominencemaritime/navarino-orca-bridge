# -----------------------------------------------
# Bridge Operation Mode
# -----------------------------------------------
DRY_RUN=True

# ---------------------------------------------------------
# Email Configuration
# ---------------------------------------------------------
ENABLE_EMAIL_ALERT=False

# -----------------------------------------------
# Datalab sync log (external.vessel_position_sync_log)
# -----------------------------------------------
SYNC_LOG_ENABLED=False
DB_DATALAB_HOST=
DB_DATALAB_PORT=5432
DB_DATALAB_NAME=
DB_DATALAB_USER=
DB_DATALAB_REGION=
DB_DATALAB_SSL_CERT=/app/certs/global-bundle.pem
DB_DATALAB_CONNECT_TIMEOUT=5
DB_DATALAB_STATEMENT_TIMEOUT_MS=5000

# ---------------------------------------------------------
# ORCA API
# ---------------------------------------------------------
ORCA_TEST=True
ORCA_BASE_URL_TEST=https://test-api.orca.example.com
ORCA_BASE_URL_LIVE=https://api.orca.example.com
ORCA_X_API_KEY=your-orca-api-key
ORCA_X_SOURCE=your-vts-source-id
ORCA_X_ORGANIZATION=your-organization-uuid

# ---------------------------------------------------------
# Scheduling
# ---------------------------------------------------------
SYNC_INTERVAL_MINUTES=5
SCHEDULE_TIMES_TIMEZONE=Europe/Athens
TIMEZONE=UTC

# ---------------------------------------------------------
# Logging
# ---------------------------------------------------------
LOG_FILE=bridge.log
LOG_LEVEL=INFO
REQUEST_TIMEOUT=30
DEBUG=False


# -----------------------------------------------
# Vessel Monitor (vessel-monitor service)
# -----------------------------------------------

# SMTP (shared name with the approved-no-po project)
SMTP_HOST=93.174.121.86
SMTP_PORT=465
SMTP_USER=alerts@prominencemaritime.com
SMTP_PASS=

# Recipients (comma-separated)
MONITOR_ALERT_RECIPIENTS=
MONITOR_ALERT_CC_RECIPIENTS=
# Parse/read-issue emails; empty falls back to MONITOR_ALERT_RECIPIENTS
MONITOR_PARSE_ERROR_RECIPIENTS=

# Feature flags
MONITOR_ENABLE_EMAIL_ALERTS=True
MONITOR_ENABLE_PARSE_ERROR_ALERTS=True

# Dry run: True = no emails, unless MONITOR_DRY_RUN_EMAIL is set (then redirected there)
MONITOR_DRY_RUN=True
MONITOR_DRY_RUN_EMAIL=

# Detection
# A vessel is in outage when its latest confirmed location is older than this
MONITOR_OUTAGE_THRESHOLD_HOURS=24
# Outage / parse-issue reminders repeat this often while the condition persists
MONITOR_ALERT_REPEAT_HOURS=24
# position = newest position timestamp in the payload; post = when the bridge POSTed
MONITOR_STALENESS_BASIS=position

# Scheduling: interval mode wins if MONITOR_SCHEDULE_FREQUENCY_HOURS is set
MONITOR_SCHEDULE_FREQUENCY_HOURS=1
MONITOR_SCHEDULE_TIMES=
#09:00,15:00
MONITOR_SCHEDULE_DAYS=
#isoweekday: 1=Mon, 2=Tue, ..., 7=Sun (empty = every day)
MONITOR_SCHEDULE_TIMES_TIMEZONE=Europe/Athens

# Timezone used for timestamps shown in emails
MONITOR_DISPLAY_TIMEZONE=UTC

# Logo in media/ (CID triton_logo)
MONITOR_LOGO=triton_logo.png

MONITOR_LOG_LEVEL=INFO

