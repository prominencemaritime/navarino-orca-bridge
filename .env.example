# -----------------------------------------------
# Bridge Operation Mode
# -----------------------------------------------
DRY_RUN=True

# ---------------------------------------------------------
# Email Configuration
# ---------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
ENABLE_EMAIL_ALERT=False
TO_RECIPIENTS=recipient1@example.com,recipient2@example.com
CC_RECIPIENTS=cc1@example.com,cc2@example.com

# ---------------------------------------------------------
# Infinity Web Services
# ---------------------------------------------------------
INFINITY_BASE_URL=https://somemainhub.infinityfleet.net
INFINITY_TOKEN=your-infinity-token
VESSEL_REF_CODE=millenniumfalcon
VESSEL_IMO=1234567

# ---------------------------------------------------------
# ORCA API
# ---------------------------------------------------------
ORCA_TEST=True
ORCA_BASE_URL_TEST=https://test-api.orca.example.com
ORCA_BASE_URL_LIVE=https://api.orca.example.com
ORCA_X_API_KEY=your-orca-api-key

# ---------------------------------------------------------
# Scheduling
# ---------------------------------------------------------
SYNC_INTERVAL_MINUTES=5
TIMEZONE=UTC

# ---------------------------------------------------------
# Logging
# ---------------------------------------------------------
LOG_FILE=bridge.log
LOG_LEVEL=INFO
REQUEST_TIMEOUT=30
DEBUG=False
